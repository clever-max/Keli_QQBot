# Comma-separated groups the bot may archive and serve. Leave empty to fail closed.
ALLOWED_GROUP_IDS=
# 旧版的单数键，仅在 ALLOWED_GROUP_IDS 为空时作为回退被读取（config.py 的 _group_id_set）。
# 新配置请只用上面的复数形式；保留说明是为了让"配置三处一致"的检查不再把它当成漏项。
# ALLOWED_GROUP_ID=

# Default allowlist for groups not listed in GROUP_AUTHORIZED_USERS.
AUTHORIZED_USERS=

# Optional per-group allowlists: group_id:qq1,qq2;group_id:qq3. Use * for all members.
GROUP_AUTHORIZED_USERS=

# OpenAI-compatible endpoint, used ONLY by the daily summary (DeepSeek by default).
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Daily summary: set SUMMARY_USE_LLM=0 to keep it entirely local.
SUMMARY_USE_LLM=1
# Character budget for the day's chat log handed to the model.
SUMMARY_DIGEST_CHARS=6000
# Hard cap for the whole report message.
SUMMARY_MAX_CHARS=600
# A run of identical text counts as 复读 from this length on (needs 2+ senders).
REPEAT_MIN_COUNT=4

# Recall history: @bot 撤回记录 shows only recalls from the last N minutes.
# Older pending recalls are reachable with "@bot 撤回记录 全部" (AUTHORIZED_USERS only).
RECALL_WINDOW_MINUTES=30
# Hard cap on how many recall events one 撤回记录 call may draw.
RECALL_MAX_COUNT=100

# 缓存图片的保留策略：原图只要不超过这两个上限就**原样保存**，不再统一压到 1000px
# （那一步曾把 4096x3072 的 4.2MB 原图存成 1000x750 / 170KB，只剩 4% 的字节）；
# 只有超限时才缩到 IMAGE_CACHE_MAX_DIMENSION 并用 IMAGE_CACHE_JPEG_QUALITY 重编码。
IMAGE_CACHE_MAX_DIMENSION=2560
IMAGE_CACHE_JPEG_QUALITY=92
# 卡片里图片框的上限；实际框宽还会被卡片内容宽度压住（取两者较小值）。
RECALL_THUMB_SIZE=1200

# QQ 内置表情（小黄脸）的图源目录。留空时自动探测本机 QQ 客户端的 sysface_res；
# 探测不到就退回腾讯表情 CDN，再失败则显示 [表情名]。卡片里的表情图会缓存到
# data/face_cache/，之后与 QQ 安装位置、网络都无关。
# QQ_FACE_DIR=C:\Users\你\Documents\Tencent Files\nt_qq\global\nt_data\Emoji\emoji-resource\sysface_res

# 漂流瓶 (@bot 漂流瓶 / 旧名 精华): 池子 = 群精华消息 + 群相册照片；
# 相册或精华里的视频直接转发，不做卡片。
# 键名沿用 ESSENCE_* 以免已有 .env 失效；数值语义与改版前完全一致。
# Per-user cooldown, per-user daily draws, how long the essence list is cached
# in memory, and how many recent draws to avoid repeating.
ESSENCE_COOLDOWN_SECONDS=60
# 每人每天的漂流瓶次数（精华池与相册池共用同一份配额）。2026-10-15 由 5 提到 10。
ESSENCE_DAILY_LIMIT=10
ESSENCE_CACHE_SECONDS=600

# ---- 减少近期重复抽样 ----------------
# lru = 每次从随机的 K 个候选里挑"最久没被抽到"的那个（推荐）；off = 纯随机。
# 两种模式下"当天不重复"的硬性规则都保留。
BOTTLE_REPEAT_MODE=lru
# 候选采样宽度 K：1 = 纯随机，越大越接近严格轮转。实测 K=5 可把"近 100 次内的不同
# 内容数"从 77 提到 97，同时保持明显随机性。
BOTTLE_REPEAT_PICK_K=5
# 抽取历史保留天数，同时决定"最久未抽"能看多远（一轮 ≈ 池子大小 / 每日抽取次数）。
# 提高它不影响"当天去重"（那只查今天），只是多存几行。
BOTTLE_HISTORY_DAYS=30

# 群相册这一半来源 (@bot 漂流瓶)。BOTTLE_ALBUM_ENABLED=0 即回到"只抽精华"的旧行为。
BOTTLE_ALBUM_ENABLED=1
# 群相册照片列表的内存缓存时长（秒）。
BOTTLE_ALBUM_CACHE_SECONDS=600
# 一次抽取有多大比例来自群相册（0-100）：0 = 只抽精华（等于关掉相册，补偿也不生效），
# 50 = 一半一半，100 = 只抽相册。
BOTTLE_ALBUM_SHARE=50
# 连续这么多次都捞到同一类时，下一次强制先试另一类（0 = 关闭这个补偿）。
BOTTLE_SWITCH_STREAK=3
# 单次拉取相册时最多翻几页 / 最多收多少张照片，防止分页异常时无限翻。
BOTTLE_ALBUM_MAX_PAGES=3
BOTTLE_ALBUM_MAX_PHOTOS=400

# OneBot reverse WebSocket access token; start-all.ps1 writes it into NapCat.
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-secret

# Optional: the bot's QQ number. start-all.ps1 writes the reverse WebSocket
# settings into NapCat's config\onebot11_<uin>.json. Leave empty to detect the
# account from an existing onebot11_*.json. config\onebot11.json always receives
# the settings, so a freshly logged-in account connects without manual setup.
NAPCAT_UIN=

# Optional: override the NapCat component directory if NapCat Desktop keeps its
# components somewhere other than the default below.
# NAPCAT_COMPONENT_DIR=C:\ProgramData\NapCatQQ Desktop\components\NapCatQQ

HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi
DATABASE_PATH=data/messages.sqlite3

# QQ numbers allowed to run the private "@bot status" report (comma separated).
STATUS_USERS=100000009

# 分群功能开关（逗号分隔，留空 = 不排除任何群）：
# 不接收喝水提醒的群；这些群仍正常归档、响应命令。
# WATER_EXCLUDED_GROUP_IDS=123450003
# 不出现在 status 报告里，且在这些群发 status 也完全静默的群。
# STATUS_EXCLUDED_GROUP_IDS=123450003
# help 只讲漂流瓶怎么用、不出现撤回记录/总结/管理员说明的群。
# BOTTLE_ONLY_HELP_GROUP_IDS=123450003

# 语音点歌（@bot 炸乌云）：`data/voice/` 目录就是曲库，歌名 = 文件名（不含扩展名）。
# 超过这个秒数的歌会被**自动截成前 N 秒**再发（QQ 语音一般只支持 60 秒左右）。
# 截断不重新编码，是在 MP3 帧边界上切，所以快且无损；缓存到 data/voice/.trimmed/。
# 设 0 表示不截断（交给 NapCat，失败时会有兜底提示）。
VOICE_MAX_SECONDS=60

# 多媒体永久归档：收到消息就把图片/视频/语音/文件存到 data/media_archive/（内容寻址、去重），
# **永不清理**——这是"保证所有消息包括多媒体永久保存"的一部分。关掉等于退回"只在查撤回时
# 按需下载"的旧行为，而 QQ 的媒体 URL 会过期，过期后就再也拿不回来。
ARCHIVE_ENABLED=1
# 单个文件的归档上限（字节，默认 100 MiB）。超过的只留一行带原因的记录、不落盘。
# 设 0 表示不限制。注意这是"上限"，不是"清理阈值"：已归档的文件永远不会被删。
ARCHIVE_MAX_BYTES=104857600
